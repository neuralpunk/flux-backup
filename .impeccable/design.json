  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The neutral default button; every action except the view's one primary.",
      "html": "<button class=\"ds-btn\">Pause schedules</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:34px;padding:0 14px;border:0;border-radius:8px;font:550 13.5px/1 'Inter Variable',Inter,'Adwaita Sans',Cantarell,system-ui,sans-serif;white-space:nowrap;transition:background-color 120ms,color 120ms,filter 120ms;background:var(--c-surface-3, #2f3238);color:var(--c-fg, #eceef1);} .ds-btn:hover{background:var(--c-track, #3a3d44);} .ds-btn:active{filter:brightness(.94);} .ds-btn:focus-visible{outline:2px solid var(--c-primary, #78b0f0);outline-offset:2px;}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one blue button of a view.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 3.5v9l7-4.5z\"/></svg> Back up all now</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:34px;padding:0 14px;border:0;border-radius:8px;font:550 13.5px/1 'Inter Variable',Inter,'Adwaita Sans',Cantarell,system-ui,sans-serif;white-space:nowrap;transition:background-color 120ms,color 120ms,filter 120ms;font-weight:650;background:var(--c-primary, #78b0f0);color:var(--c-on-primary, #0b1626);} .ds-btn-primary:hover{filter:brightness(1.08);} .ds-btn-primary:active{filter:brightness(.94);} .ds-btn-primary:focus-visible{outline:2px solid var(--c-primary, #78b0f0);outline-offset:2px;}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "A quieter secondary action beside a default button.",
      "html": "<button class=\"ds-btn-ghost\">Fix its settings</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:34px;padding:0 14px;border:0;border-radius:8px;font:550 13.5px/1 'Inter Variable',Inter,'Adwaita Sans',Cantarell,system-ui,sans-serif;white-space:nowrap;transition:background-color 120ms,color 120ms,filter 120ms;background:transparent;color:var(--c-fg-2, #b8bcc3);} .ds-btn-ghost:hover{background:var(--c-surface-3, #2f3238);color:var(--c-fg, #eceef1);} .ds-btn-ghost:focus-visible{outline:2px solid var(--c-primary, #78b0f0);outline-offset:2px;}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger-filled",
      "description": "Confirm button of a destructive dialog only.",
      "html": "<button class=\"ds-btn-danger\">Delete backup</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:34px;padding:0 14px;border:0;border-radius:8px;font:550 13.5px/1 'Inter Variable',Inter,'Adwaita Sans',Cantarell,system-ui,sans-serif;white-space:nowrap;transition:background-color 120ms,color 120ms,filter 120ms;font-weight:650;background:var(--c-danger, #ef8576);color:var(--c-surface-1, #1c1e22);} .ds-btn-danger:hover{filter:brightness(1.08);} .ds-btn-danger:focus-visible{outline:2px solid var(--c-primary, #78b0f0);outline-offset:2px;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Filled control, no stroke; blue outline on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Name this backup\" />",
      "css": ".ds-input{height:36px;width:260px;border:0;border-radius:8px;background:var(--c-surface-3, #2f3238);padding:0 12px;font:400 14px 'Inter Variable',Inter,system-ui,sans-serif;color:var(--c-fg, #eceef1);caret-color:var(--c-primary, #78b0f0);transition:background-color 120ms;} .ds-input::placeholder{color:var(--c-fg-muted, #949aa4);} .ds-input:focus{outline:2px solid var(--c-primary, #78b0f0);outline-offset:-1px;}"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Outlined descriptor (where, when, how): information, never a control.",
      "html": "<span class=\"ds-tag\">Every hour</span> <span class=\"ds-tag ds-tag-warn\">Runs as root</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px;border-radius:6px;box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--c-fg, #eceef1) 16%,transparent);color:var(--c-fg-2, #b8bcc3);font:400 12.5px/1 'Inter Variable',Inter,system-ui,sans-serif;white-space:nowrap;} .ds-tag-warn{box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--c-warning, #e7b65a) 45%,transparent);color:var(--c-warning, #e7b65a);}"
    },
    {
      "name": "Segmented Control",
      "kind": "nav",
      "refersTo": "segmented",
      "description": "Adwaita toggle group; the chosen segment is a neutral lift, never blue.",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Overview</button><button role=\"tab\" aria-selected=\"false\">Snapshots</button><button role=\"tab\" aria-selected=\"false\">Activity</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:3px;border-radius:10px;background:var(--c-surface-3, #2f3238);} .ds-seg>button{height:30px;padding:0 14px;border:0;border-radius:7px;background:transparent;font:550 13.5px 'Inter Variable',Inter,system-ui,sans-serif;color:var(--c-fg-2, #b8bcc3);transition:background-color 120ms,color 120ms;} .ds-seg>button:hover:not([aria-selected=true]){color:var(--c-fg, #eceef1);background:color-mix(in oklab,var(--c-fg, #eceef1) 6%,transparent);} .ds-seg>button[aria-selected=true]{background:var(--c-seg-on, #4a4e56);color:var(--c-fg, #eceef1);box-shadow:0 1px 2px rgb(0 0 0/.22),0 0 0 1px rgb(0 0 0/.04);} .ds-seg>button:focus-visible{outline:2px solid var(--c-primary, #78b0f0);outline-offset:2px;}"
    },
    {
      "name": "Grouped List",
      "kind": "card",
      "refersTo": "group",
      "description": "One rounded group, rows split by hairlines; interactive rows lift and end in a chevron.",
      "html": "<div class=\"ds-rows\"><button class=\"ds-row\"><span class=\"ds-glyph ds-ok\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3.5 8.5 3 3 6-7\"/></svg></span><span class=\"ds-txt\"><b>Home folder</b><small>Protected · 59 minutes ago</small></span><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 3.5 10.5 8 6 12.5\"/></svg></button><button class=\"ds-row\"><span class=\"ds-glyph ds-bad\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2.5 14 13H2z\"/><path d=\"M8 6.5v3M8 11.3v.2\"/></svg></span><span class=\"ds-txt\"><b>Photo library</b><small class=\"ds-red\">Failed 2 days ago</small></span><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 3.5 10.5 8 6 12.5\"/></svg></button></div>",
      "css": ".ds-rows{display:flex;flex-direction:column;width:420px;border-radius:12px;background:var(--c-surface-2, #25272c);box-shadow:0 0 0 1px var(--c-group-edge, transparent);overflow:hidden;font-family:'Inter Variable',Inter,system-ui,sans-serif;} .ds-row{display:flex;align-items:center;gap:14px;min-height:52px;padding:10px 16px;border:0;background:transparent;color:var(--c-fg, #eceef1);text-align:left;transition:background-color 120ms;} .ds-row+.ds-row{box-shadow:inset 0 1px 0 var(--c-sep, #34373d);} .ds-row:hover{background:color-mix(in oklab,var(--c-fg, #eceef1) 5%,var(--c-surface-2, #25272c));} .ds-row:focus-visible{outline:2px solid var(--c-primary, #78b0f0);outline-offset:2px;outline-offset:-2px;} .ds-row>svg{color:var(--c-fg-muted, #949aa4);flex:none;} .ds-txt{flex:1;display:flex;flex-direction:column;gap:2px;} .ds-txt b{font-weight:600;font-size:14px;} .ds-txt small{font-size:12.5px;color:var(--c-fg-muted, #949aa4);} .ds-txt small.ds-red{color:var(--c-danger, #ef8576);} .ds-glyph{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:9999px;flex:none;} .ds-ok{color:var(--c-success, #72c79a);background:color-mix(in oklab,var(--c-success, #72c79a) 16%,transparent);} .ds-bad{color:var(--c-danger, #ef8576);background:color-mix(in oklab,var(--c-danger, #ef8576) 17%,transparent);}"
    },
    {
      "name": "History Strip",
      "kind": "custom",
      "refersTo": "history-strip",
      "description": "Signature: 30 days as dots on a fixed 4 to 11px log magnitude ramp in 13px cells; red for failure-only days, hollow for none.",
      "html": "<div class=\"ds-strip\" role=\"img\" aria-label=\"Last 15 days: backed up on 12, failed on 1, nothing on 2\"><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:4px;height:4px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:6px;height:6px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:9px;height:9px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:11px;height:11px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:7px;height:7px\"></span></span><span class=\"ds-cell\"><span class=\"ds-none\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:5px;height:5px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:4px;height:4px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:8px;height:8px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:10px;height:10px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot ds-bad\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:11px;height:11px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:6px;height:6px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:4px;height:4px\"></span></span><span class=\"ds-cell\"><span class=\"ds-dot\" style=\"width:5px;height:5px\"></span></span></div>",
      "css": ".ds-strip{display:flex;align-items:center;height:16px;} .ds-cell{display:grid;place-items:center;width:13px;height:16px;flex:none;} .ds-dot{display:block;border-radius:9999px;background:var(--c-success, #72c79a);} .ds-dot.ds-bad{width:8px;height:8px;background:var(--c-danger, #ef8576);} .ds-none{display:block;width:4px;height:4px;border-radius:9999px;box-shadow:0 0 0 1px var(--c-fg-muted, #949aa4);}"
    },
    {
      "name": "Switch",
      "kind": "custom",
      "refersTo": "switch",
      "description": "Adwaita-proportioned on/off switch; blue when on.",
      "html": "<button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Encrypt\"><span></span></button> <button class=\"ds-switch\" role=\"switch\" aria-checked=\"false\" aria-label=\"Notify\"><span></span></button>",
      "css": ".ds-switch{position:relative;width:44px;height:24px;border:0;border-radius:9999px;background:var(--c-track, #3a3d44);transition:background-color 150ms;} .ds-switch[aria-checked=true]{background:var(--c-primary, #78b0f0);} .ds-switch>span{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:9999px;background:#f4f5f7;box-shadow:0 1px 2px rgb(0 0 0/.3);transition:transform 150ms cubic-bezier(.22,1,.36,1);} .ds-switch[aria-checked=true]>span{transform:translateX(20px);} .ds-switch:focus-visible{outline:2px solid var(--c-primary, #78b0f0);outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "At home on the desktop",
    "overview": "**Creative North Star: \"At home on the desktop\"**\n\nFlux looks like it shipped with the user's Linux desktop. It follows the GNOME/Adwaita screen tradition in graphite and calm blue: a blue-graphite shell (titlebar and sidebar) around a flatter graphite view, and content set in grouped lists, one rounded group with rows split by hairlines, instead of a box per item. The app answers \"am I protected?\" in one sentence before anything else, and type carries the hierarchy; there are no stat boxes.\n\nColour has one job each. Blue means act: the one primary button of a view, progress, focus, an on switch. Green, amber and red mean state, and always sit next to words that say the same thing. Where you are (the sidebar item, the chosen segment) is a neutral lift, never blue. Machine data (paths, sizes, counts, times, shortcuts) is JetBrains Mono with tabular figures; everything else is Inter, the face Adwaita Sans is built on.\n\nThe signature is the protection sentence over a 30-day history strip of dots on a fixed magnitude ramp. The same grammar answers for all backups on the start page and for one backup on its own page, and the same ramp marks each snapshot.",
    "keyCharacteristics": [
      "Two-tone frame: blue-graphite shell, flatter graphite view with a 14px top-left corner.",
      "Grouped lists with hairline separators; interactive rows end in a chevron or a control.",
      "One blue primary button per view; state colours never stand alone without words.",
      "Selection is a neutral lift, in the sidebar and in segmented controls.",
      "Inter for UI, JetBrains Mono for machine data, tabular numbers on everything that changes.",
      "A fixed log-scale magnitude ramp (4 to 11px dots) for history and snapshots."
    ],
    "rules": [
      {
        "name": "The One Job Rule",
        "body": "Blue acts, green/amber/red report state, a neutral lift says where you are. No colour does two of these jobs.",
        "section": "colors"
      },
      {
        "name": "The One Blue Button Rule",
        "body": "A view has at most one `.btn-primary`. Its siblings are neutral `.btn` or `.btn-ghost`.",
        "section": "colors"
      },
      {
        "name": "The Words-With-Colour Rule",
        "body": "A status colour always accompanies words that say the same (\"Failed 2 days ago\", \"1 needs attention\"). A glyph repeats the state; it never replaces the sentence. The failed row on All backups is tinted (`danger` at 7%) and its status line is red text.",
        "section": "colors"
      },
      {
        "name": "The Machine Data Rule",
        "body": "Paths, sizes, counts and times are JetBrains Mono; every number that changes while you watch carries tabular figures (`.num` / `.tabular`, automatic on `.font-mono`) so it doesn't jitter.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Headings are sentence case and plain words; no uppercase labels, no letter-spaced captions.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Shadow Rule",
        "body": "Only what floats above the window (dialogs, menus, toasts) casts a shadow. Groups and rows sit on the view with tone and, in light, a hairline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set content as a grouped list: one 12px group, rows split by 1px `sep` hairlines.",
      "Do give each view at most one `primary` button; everything else is neutral.",
      "Do say the state in words next to every green, amber or red mark.",
      "Do show where you are with the neutral `selected` or `seg-on` lift.",
      "Do set machine data in JetBrains Mono with tabular figures.",
      "Do mark history and snapshots on the fixed 4 to 11px log ramp in 13px cells.",
      "Do put a dialog's close button last in the DOM.",
      "Do keep the logo on its dark tile, in the light theme too."
    ],
    "donts": [
      "Don't use blue for selection, tabs or state; blue is for acting.",
      "Don't wrap each item in its own box, nest groups inside groups, or build stat boxes.",
      "Don't fill a tag; filled means button.",
      "Don't scale the history ramp to each backup; marks must compare across backups.",
      "Don't add shadows to groups or rows; only floating layers cast them.",
      "Don't round the window; only the view's top-left corner carries the panel radius."
    ]
  }
}